# ============================================
# KAIROS TUTOR - .gitignore
# ============================================

# ============================================
# БАЗЫ ДАННЫХ
# ============================================
database/*.db
database/*.sqlite
database/*.sqlite3
database/*.db-journal
database/*.db-wal
database/*.db-shm
*.db
*.sqlite

# ============================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ============================================
.env
.env.local
.env.development
.env.production
*.env

# ============================================
# ЛОГИ (но оставляем .gitkeep)
# ============================================
logs/*.log
logs/!*.gitkeep
*.log

# ============================================
# ЭКСПОРТЫ (но оставляем .gitkeep)
# ============================================
exports/*.csv
exports/*.xlsx
exports/*.xls
exports/*.pdf
exports/!*.gitkeep
exports/reports/*
exports/!reports/.gitkeep

# ============================================
# ASSETS (но оставляем .gitkeep)
# ============================================
assets/!*.gitkeep
assets/icons/*
assets/icons/!*.gitkeep

# ============================================
# DATABASE (но оставляем .gitkeep)
# ============================================
database/!*.gitkeep

# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.manifest
*.spec

# ============================================
# ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ
# ============================================
venv/
env/
.venv/
ENV/
*.venv/

# ============================================
# IDE И РЕДАКТОРЫ
# ============================================
.vscode/
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ============================================
# ОПЕРАЦИОННЫЕ СИСТЕМЫ
# ============================================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
._*

# ============================================
# ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ
# ============================================
venv/
.venv/
env/
ENV/