# ============================================
# KAIROS TUTOR - Переменные окружения (ШАБЛОН)
# ============================================

# Путь к базе данных (локальный)
DB_PATH=database/kairos.db

# Название приложения
APP_NAME=Kairos Tutor

# Режим отладки (True/False)
DEBUG=False

# Путь к файлу стилей
STYLES_PATH=styles/theme.qss

# Логирование
LOG_LEVEL=INFO
LOG_PATH=logs/app.log

# Экспорт данных
EXPORT_PATH=exports/